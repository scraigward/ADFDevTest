{
	"name": "landData",
	"properties": {
		"activities": [
			{
				"name": "LookupMetaInterface",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "select * from metadata.interfaces where runflag = 'Y'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureDataFactoryDB",
						"type": "DatasetReference",
						"parameters": {
							"dbSchema": "metadata",
							"dbTable": "interfaces"
						}
					}
				}
			},
			{
				"name": "InterfaceVariables",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LookupMetaInterface",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "InterfaceRowValues",
					"value": {
						"value": "@activity('LookupMetaInterface').output.firstRow.interfaces\n",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"InterfaceRowValues": {
				"type": "String"
			}
		},
		"annotations": []
	}
}