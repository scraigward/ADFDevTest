{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AzureDataFactorySCW"
		},
		"SQLServerIonos_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SQLServerIonos'"
		},
		"SQLServerIonos_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "77.68.110.173,7070"
		},
		"SQLServerIonos_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AzureDataFactoryDB"
		},
		"SQLServerIonos_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/SQLServerIonos')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('SQLServerIonos_properties_typeProperties_server')]",
					"database": "[parameters('SQLServerIonos_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('SQLServerIonos_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('SQLServerIonos_password')]"
					}
				},
				"connectVia": {
					"referenceName": "integrationRuntimeIonos",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/integrationRuntimeIonos')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/integrationRuntimeIonos')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataFactoryDB')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "SQLServerIonos",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"dbSchema": {
						"type": "string"
					},
					"dbTable": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "SqlServerTable",
				"schema": [],
				"typeProperties": {
					"schema": {
						"value": "@dataset().dbSchema",
						"type": "Expression"
					},
					"table": {
						"value": "@dataset().dbTable",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/SQLServerIonos')]"
			]
		}
	]
}